{"author": "Gaurav Kumar Yadav", "bin": {"http-run": "./dist/cli.js"}, "bugs": {"url": "https://github.com/xgauravyaduvanshii/http-file-runner/issues"}, "description": "Zero-dependency TypeScript CLI that runs named HTTP requests from a requests.yaml file, with env vars, assertions, chaining, retries, HTML reports and a mock server for frontend dev.", "devDependencies": {"@types/node": "^22.10.2", "typescript": "^5.7.2", "vitest": "^2.1.8"}, "engines": {"node": ">=18"}, "files": ["dist", "README.md", "LICENSE"], "homepage": "https://github.com/xgauravyaduvanshii/http-file-runner#readme", "keywords": ["http", "api", "rest", "cli", "yaml", "testing", "ci", "curl", "retry", "mock"], "license": "MIT", "main": "./dist/cli.js", "name": "http-file-runner", "repository": {"type": "git", "url": "https://github.com/xgauravyaduvanshii/http-file-runner.git"}, "scripts": {"build": "tsc -p tsconfig.build.json", "lint": "tsc --noEmit", "test": "vitest run"}, "type": "module", "version": "0.2.0"}